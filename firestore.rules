rules_version = '2';
// Café Cantinho: each player owns cafes/{their uid}; gifts are written by the sender and read/removed by the recipient.
service cloud.firestore {
  match /databases/{database}/documents {
    // playing requires a real account (e-mail or Google): anonymous sessions from before login can read, not write
    function member() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    match /cafes/{uid} {
      allow read: if request.auth != null;
      allow write: if member() && request.auth.uid == uid
                   && request.resource.data.json is string && request.resource.data.json.size() < 900000;
    }
    match /gifts/{id} {
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if member() && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string && request.resource.data.json.size() < 4000;
      allow delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
